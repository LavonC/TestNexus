# ==========================================
# GoaIT Career Intelligence Platform Configuration
# ==========================================

# Database: Turso (LibSQL) Cloud Configuration (Required for Render Free Tier)
# Get your free database at https://turso.tech (5GB free, no 30-day expiration)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Local SQLite fallback path (used when TURSO_DATABASE_URL is empty)
DB_PATH=data/goa_companies.db

# Web & Admin Settings
ADMIN_SECRET=change-me-to-a-strong-secret-token
FRONTEND_URL=http://localhost:5173

# Optional: Server-side Google Gemini API Key for chatbot Q&A
# Users can also supply their own key directly in the web chat UI.
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-flash-lite-latest

# Optional: Resend API Key for Job Email Alerts (Free tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=alerts@goait.dev

# Scraping & Ingestion Settings (Tuned for Render 512MB RAM free tier)
MAX_CONCURRENT_SCRAPES=5
HTTP_TIMEOUT_SECONDS=12.0
RSS_TIMEOUT_SECONDS=10.0
BATCH_SIZE=5
RATE_LIMIT_RPM=12.0

# Paths
SEED_FILE_PATH=data/companies_seed.json
EXPORTS_DIR=data/exports

# Logging
LOG_LEVEL=INFO
